# Copy to .env and adjust. Every value is optional: the defaults work on first start.

# --- Access -----------------------------------------------------------------------------
# Comma-separated API keys, optionally named ("systemb:sk-...,admin:sk-..."). Empty = no auth.
# Each key owns the sessions it creates. Generate keys with: openssl rand -hex 24
API_KEYS=
RATE_LIMIT_PER_MINUTE=120
# Docker port binding. Use API_BIND=0.0.0.0 to expose the API beyond this machine (set API_KEYS!).
API_BIND=127.0.0.1
API_PORT=8000
# Public URL of the API (used to build interactive-login viewer links), e.g. https://api.example.com
PUBLIC_BASE_URL=
CORS_ORIGINS=

# --- Secrets for internal services ----------------------------------------------------------
# Change both before exposing anything. Generate with: openssl rand -hex 32
SEARXNG_SECRET=change-me-searxng-secret
CRAWL4AI_API_TOKEN=change-me-crawl4ai-internal-token

# --- Sessions -----------------------------------------------------------------------------
# Fernet key(s) used to encrypt stored sessions; comma-separate to rotate (first one encrypts).
# Empty = a key is generated on first start and stored next to the database (/data/session.key).
# Generate one with: docker compose run --rm api search-extract-api --generate-key
SESSION_ENCRYPTION_KEY=
LOGIN_TIMEOUT_SECONDS=600
# Human-like pacing for requests made with a session.
SESSION_MIN_INTERVAL=4
SESSION_JITTER=3
SESSION_MAX_REQUESTS_PER_HOUR=120
DOMAIN_MIN_INTERVAL=1

# --- LLM (any OpenAI-compatible endpoint) -------------------------------------------------
# Default: Ollama running on the Docker host. With the bundled Ollama use
# COMPOSE_PROFILES=ollama and LLM_BASE_URL=http://ollama:11434/v1. Set "none" to disable.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_CHAT_MODEL=qwen2.5:7b-instruct
# Embeddings default to the chat endpoint; set these to use a different provider/model.
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=bge-m3
# COMPOSE_PROFILES=ollama

# --- Search -------------------------------------------------------------------------------
SEARCH_DEFAULT_LANGUAGE=
# Commercial fallbacks: auto (when free sources fail / return few results), always or never.
SEARCH_FALLBACK=auto
TAVILY_API_KEY=
EXA_API_KEY=

# --- Verticals & sources --------------------------------------------------------------------
# Empty = all verticals (web is always on). Example: ENABLED_VERTICALS=news,linkedin,idealista
ENABLED_VERTICALS=
# Example: DISABLED_SOURCES=gdelt,arbeitnow
DISABLED_SOURCES=
IDEALISTA_API_KEY=
IDEALISTA_API_SECRET=

# --- Operation ------------------------------------------------------------------------------
LOG_LEVEL=INFO
CACHE_TTL_SEARCH=600
CACHE_TTL_EXTRACT=3600
# Allow fetching private/loopback addresses (disables the SSRF guard). Keep false.
ALLOW_PRIVATE_URLS=false
